#!/usr/bin/env bash
# Pre-commit hook: typecheck + test + build when inputs change.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "[pre-commit] typecheck"
bun run typecheck

echo "[pre-commit] test"
bun run test

if git diff --cached --quiet -- \
  src/ \
  bun.build.ts \
  package.json \
  bun.lock \
  tsconfig.json \
  tsconfig.build.json \
  tsconfig.emit.json
then
  echo "[pre-commit] build inputs unchanged, skipping build"
else
  echo "[pre-commit] build"
  bun run build
fi
