{
  "name": "@terella/action-framework",
  "version": "0.0.6",
  "description": "DI-friendly GitHub Actions framework with terella-action CLI for init and build",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "terella-action": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bun bun.build.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.build.json",
    "typecheck:examples": "tsc --noEmit -p examples/tsconfig.json",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "bun test ./examples ./src ./actions",
    "build:actions": "bun run scripts/build-actions.ts",
    "prepublishOnly": "DO_NOT_TRACK=1 bun run build",
    "postinstall": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "test:local": "local-action run ."
  },
  "author": "github.com/terella-project",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/terella-project/action-framework.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.1.1",
    "@di-framework/core": "^4.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@github/local-action": "^7.0.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  }
}
